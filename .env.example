# Copy to .env and fill in. .env is gitignored.

# Password of the PostgreSQL user "metrics" (any long random string).
POSTGRES_PASSWORD=

# Slack app bot token (scope lists:read) and the ID of the List to sync (F…).
SLACK_BOT_TOKEN=
SLACK_LIST_ID=
# A project's own List (e.g. JugendLab, F…), read once by `metrics transfer-slack`; its columns
# are mapped in [slack.project_list] of the instance config.toml.
SLACK_PROJECT_LIST_ID=

# Login for the analysis page (/analyse): password, oidc (e.g. Keycloak) or off (local tests only).
AUTH_MODE=password

# AUTH_MODE=password: the shared team password must be switched on explicitly (keep it false
# wherever single sign-on is available; it is off on the server) and needs its hash. Create it with
#   docker compose run --rm app metrics hash-password
# Without both the team pages stay locked.
ALLOW_PASSWORD_LOGIN=false
TEAM_PASSWORD_HASH=

# AUTH_MODE=oidc: the provider's issuer URL (Keycloak: https://<host>/realms/<realm>) and a
# confidential client with redirect URI <PUBLIC_URL>/login/callback.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional: only members of this group may log in (needs a "groups" claim in the ID token).
OIDC_ALLOWED_GROUP=
# Optional: members of this group are admins (review page) and may always log in.
OIDC_ADMIN_GROUP=
# Token claim holding the groups (default: groups).
OIDC_GROUPS_CLAIM=
# Address people use to open the app, e.g. https://metrics.example.org (needed behind a reverse proxy).
PUBLIC_URL=

# Signs the short-lived login state cookie (any long random string). Logins themselves are
# server-side sessions in the database: 12 hours at most, ended after 2 hours without activity.
SESSION_SECRET=

# Reverse proxy address(es) whose X-Forwarded-* headers are trusted (comma-separated IPs).
FORWARDED_ALLOW_IPS=127.0.0.1

# Course calendar (optional, WM-110): a CalDAV collection, e.g. the Nextcloud calendar
# .../remote.php/dav/calendars/<user>/<calendar>/ of the app's own account, with an app password.
# CALDAV_ORGANIZER is that account's e-mail address: with it, lead and support are invited as
# attendees and Nextcloud mails invitations, updates and cancellations. Without CALDAV_URL
# planning runs without a calendar. For local tries: `metrics fake-calendar` (see README).
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=
CALDAV_ORGANIZER=

# Private instance directory and legacy CSV directory (defaults: the public examples).
INSTANCE_DIR=./instance
LEGACY_DATA_DIR=./old_data

# Where the app listens on the host.
APP_BIND=127.0.0.1
APP_PORT=8000
