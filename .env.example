# Copy to .env and fill in. .env is gitignored.

# Password of the PostgreSQL user "metrics" (any long random string).
POSTGRES_PASSWORD=

# Slack app bot token (scope lists:read) and the ID of the List to sync (F…).
SLACK_BOT_TOKEN=
SLACK_LIST_ID=

# Login for the analysis page (/analyse): password or off (local tests only).
AUTH_MODE=password

# AUTH_MODE=password: hash of the shared team password. Create it with
#   docker compose run --rm app metrics hash-password
# Without a hash the analysis page stays locked.
TEAM_PASSWORD_HASH=

# Signs the login cookie (any long random string; if empty, a restart logs everyone out).
SESSION_SECRET=

# Private instance directory and legacy CSV directory (defaults: the public examples).
INSTANCE_DIR=./instance
LEGACY_DATA_DIR=./old_data

# Where the app listens on the host.
APP_BIND=127.0.0.1
APP_PORT=8000
